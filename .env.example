# Database
DATABASE_URL=postgres://stratbench:stratbench@localhost:5432/stratbench

# Server
HOST=0.0.0.0
PORT=8080
WORKERS=4
DB_MAX_CONNECTIONS=20
MAX_CONCURRENT_RUNS=4
RUST_LOG=info,stratbench=debug

# Alpaca API (optional — needed for live market data) 
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# FinRL gRPC Service
FINRL_GRPC_ENDPOINT=http://localhost:50051

# Redis Cache (used by Python FinRL service)
REDIS_URL=redis://localhost:6379
