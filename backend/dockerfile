# Multi-stage build for the Rust backend.
# Build context is the repository root (set in docker-compose.yml) so that
# python/protos/finrl_service.proto is accessible during tonic-build.

# ── Stage 1: build the binary ─────────────────────────────────────────────
FROM rust:1.90-slim-bookworm AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev protobuf-compiler && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy proto definitions needed by build.rs (tonic-build)
COPY python/protos ./python/protos

# Cache dependency compilation using a dummy binary
COPY backend/Cargo.toml backend/Cargo.lock* ./
RUN mkdir -p src && echo "fn main() {}" > src/main.rs
COPY backend/build.rs ./
RUN cargo build --release && rm -rf src

# Build the real application
COPY backend/src ./src
COPY backend/migrations ./migrations
RUN touch src/main.rs && cargo build --release

# ── Stage 2: minimal runtime image ────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates libssl3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/stratbench /app/stratbench
COPY --from=builder /app/migrations /app/migrations

EXPOSE 8080

CMD ["/app/stratbench"]
